# `npm run setup` creates .env for you. These are the settings it uses.
# Use devnet-only throwaway keys. Never put a key that holds real money here.
FACILITATOR_KEY=
RECEIVER_AUTHORIZER_KEY=
OPERATOR_KEY=
SELLER_KEY=
SELLER2_KEY=
AGENT_KEY=
TEST_MINT=
ADMIN_TOKEN=
SVM_RPC_URL=https://api.devnet.solana.com

# Used only for the dashboard's network fee estimate.
# ASSUMED_SOL_PRICE=150
# ASSUMED_LAMPORTS_PER_TX=10001

# Only for sellers whose provider type is "anthropic".
# ANTHROPIC_API_KEY=
